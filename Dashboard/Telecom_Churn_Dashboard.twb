      <aliases enabled='yes' />
      <column caption='Churn Rate %' datatype='real' name='[Calculation_1052238421659648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churn]) / COUNT([customer_id]) * 100' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_1052238421889025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([customer_id]) - SUM([churn])' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_1052238424563714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churn])' />
      </column>
      <column caption='Avg Data Used' datatype='real' name='[Calculation_1052238424690691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([data_used])' />
      </column>
      <column caption='Avg Calls Made' datatype='real' name='[Calculation_1052238424825860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([calls_made])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1052238424920069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;18-29&quot; ELSEIF [age] &lt; 45 THEN &quot;30-44&quot; ELSEIF [age] &lt; 60 THEN &quot;45-59&quot; ELSE &quot;60+&quot; END' />
      </column>
